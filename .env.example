# Copy to .env and set real values. Never commit .env.
#   cp .env.example .env
#
# Who reads this file:
#   docker compose      -> reads it automatically
#   docker run          -> only with --env-file .env
#   go run (your shell) -> does NOT read it; export vars yourself
#   Kubernetes          -> does not use it (ConfigMap + Secret instead)

# --- Postgres (required) ---
# Used by the postgres container, migrate, and the DATABASE_URL that compose builds.
# Password: letters and digits only (@ : / break the URL).
POSTGRES_USER=priceboard
POSTGRES_PASSWORD=changeme
POSTGRES_DB=prices

# --- DATABASE_URL (only for running outside compose) ---
# compose builds its own from POSTGRES_* above, so the password stays in one place.
# Keep this in sync with POSTGRES_* if you use it.
#   docker run --env-file .env  -> host "postgres" (as below)
#   go run on the laptop        -> host "localhost" (export it in your shell)
DATABASE_URL=postgres://priceboard:changeme@postgres:5432/prices?sslmode=disable

# --- Fetcher (optional, defaults in code) ---
BINANCE_PRICE_URL=https://api.binance.com/api/v3/ticker/price
SYMBOLS=BTCUSDT,ETHUSDT

# --- API (optional, default in code) ---
# PORT=8080
